# ────────────────────────────────────────────────────────────────
# KOSHA API
# https://www.data.go.kr 에서 발급
# ────────────────────────────────────────────────────────────────
KOSHA_API_KEY=4661693ceadc6fd88f4ad91bb7167f7088d7e1f2f219f80334298b5d9a2a2203

# ────────────────────────────────────────────────────────────────
# Google Drive
# 서비스 계정 키: credentials/gdrive_service_account.json
# 최상위 공유 폴더 ID (Drive URL에서 확인)
# ────────────────────────────────────────────────────────────────
GDRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ────────────────────────────────────────────────────────────────
# Gmail (OAuth2 토큰: credentials/gmail_token.json)
# 최초 1회: python scripts/setup_gmail.py 실행
# ────────────────────────────────────────────────────────────────
GMAIL_SENDER=your@gmail.com
GMAIL_RECIPIENT=recipient@gmail.com

# ────────────────────────────────────────────────────────────────
# Gmail App Password (GitHub Actions 긴급 알림 전용)
# Gmail → 보안 → 앱 비밀번호 발급 (2단계 인증 필요)
# ────────────────────────────────────────────────────────────────
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ────────────────────────────────────────────────────────────────
# ⚠️ ANTHROPIC_API_KEY 는 절대 설정하지 않는다
#    Claude Code는 로컬 OAuth($20 구독)만 사용
# ────────────────────────────────────────────────────────────────
